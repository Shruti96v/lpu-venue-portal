# Docker Hub registry settings (For CI/CD reference)
DOCKER_USERNAME=your_docker_hub_username

# Backend configurations (Container networking)
PORT=5005
NODE_ENV=production
JWT_SECRET=super_secret_session_key_change_me_in_production
JWT_EXPIRE=30d

# MongoDB connection string
# Defaults to the docker service name "mongodb" for internal container communication
MONGO_URI=mongodb://mongodb:27017/smart-finance-manager

# Frontend Nginx configurations (Routing backend traffic)
# Defaults to the docker service name "backend" and port 5005
BACKEND_URL=http://backend:5005
